# ── LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── MLflow ─────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection

# ── Langfuse ───────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Kaggle ─────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_api_key

# ── LocalStack (AWS S3 simulation) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
FEATURE_STORE_BUCKET=fraud-detection-features
# boto3 1.36+ adds CRC32 checksums; LocalStack requires this to be disabled
AWS_REQUEST_CHECKSUM_CALCULATION=when_required

# ── App ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MODEL_NAME=fraud_detector_rf
MODEL_VERSION=1.0.0
RISK_LEVEL=high
OWNER_EMAIL=your@email.com
